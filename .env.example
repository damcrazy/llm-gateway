# ---------------------------------------------------------------------------
# LLM Gateway configuration. Everything is read at runtime, so the same build
# or Docker image works anywhere. Copy to .env (Docker) or .env.local (next dev).
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API Keys)
# Supabase's own names also work: NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (or ..._PUBLISHABLE_DEFAULT_KEY / ..._ANON_KEY).
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server-only, never expose it.
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts provider API keys at rest. Generate with:
#   openssl rand -base64 32
# Keep it safe: losing it means re-entering every provider credential.
GATEWAY_ENCRYPTION_KEY=

# The account that can manage other admins (cannot be removed from the dashboard)
SUPERADMIN_EMAIL=kalyanb2000@gmail.com

# Public URL of this deployment, used in code snippets.
# Optional on Vercel/behind a proxy that sets X-Forwarded-Host.
APP_URL=http://localhost:3000
