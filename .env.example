# ---------------------------------------------------------------------------
# LLM Gateway configuration. Everything is read at runtime, so the same build
# or Docker image works anywhere. Copy to .env (Docker) or .env.local (bun dev).
# Against a local Supabase stack, `bun run setup` writes .env.local for you.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API Keys)
# Supabase's own names also work: NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (or ..._PUBLISHABLE_DEFAULT_KEY / ..._ANON_KEY).
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server-only, never expose it.
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts provider API keys at rest. Generate with:
#   openssl rand -base64 32
# Keep it safe: losing it means re-entering every provider credential.
GATEWAY_ENCRYPTION_KEY=

# Your email. When this account signs in (after confirming its email), it
# becomes the superadmin: it manages members and admins, and can't be removed.
SUPERADMIN_EMAIL=you@example.com

# Public URL of this deployment, used in code snippets.
# Optional on Vercel/behind a proxy that sets X-Forwarded-Host.
APP_URL=http://localhost:3000

# Optional, Vercel builds only: a database connection lets production builds
# apply new migrations (scripts/migrate.mjs). The Supabase integration on
# Vercel sets these; with your own project, use the session pooler's connection
# string (Supabase -> Connect). Without them, run `bunx supabase db push`.
# POSTGRES_URL=
